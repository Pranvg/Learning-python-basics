class CricketPlayer:

    team_name = "india" 


    def __init__(self, name, role, stamina, no):

        self.name = name 
        self.role = role
        self.stamina = stamina
        self.no = no

    def play_shot(self):
        self.stamina -= 10
        print(f" {self.name} player has played a shot and now his stamina is {self.stamina} ")


    @classmethod 
    def change_team(cls, new_team):
      cls.team_name = new_team
      print(f"new team name is: {cls.team_name}")



    @staticmethod
    def calculate_run_rate(runs, overs):
      run_rate = runs / overs
      return f" the now run rate is {run_rate} "



